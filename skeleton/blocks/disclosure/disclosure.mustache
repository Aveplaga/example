<section class="disclosure" id="disclosure">
    <div class="disclosure__container container">
        <div class="disclosure__main">
            <div class="disclosure__title">{{disclosure__title}}</div>

            <div class="disclosure__accordion">
                {{#disclosure__items}}
                    <div class="disclosure__item">
                        <div class="disclosure__item-number">{{disclosure__item-number}}</div>

                        <div class="disclosure__item-container">
                            <div class="disclosure__item-title">{{disclosure__item-title}}</div>

                            <button class="disclosure__item-button">
                                <svg class="disclosure__button-icon" xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24">
                                    <path fill="currentColor" d="M5.293 5.293a1 1 0 0 1 1.414 0L12 10.586l5.293-5.293a1 1 0 1 1 1.414 1.414L13.414 12l5.293 5.293a1 1 0 0 1-1.414 1.414L12 13.414l-5.293 5.293a1 1 0 0 1-1.414-1.414L10.586 12L5.293 6.707a1 1 0 0 1 0-1.414" />
                                </svg>
                            </button>
                        </div>

                        <div class="disclosure__item-subtitle">{{disclosure__item-subtitle}}</div>
                    </div>
                {{/disclosure__items}}
            </div>
        </div>
    </div>
</section>