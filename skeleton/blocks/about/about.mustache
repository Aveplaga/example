<div id="about" class="about homepage-fade">
    <div class="wrapper">
        <div class="about__wrapper">
            <div class="about__title--wrapper">
                <div class="about__title about__title--desktop">{{about__title--desktop}}</div>
                <div class="about__title about__title--mobile">{{about__title--mobile}}</div>
            </div>

            <div class="about__list">
                {{#about__list--items}}
                    <div class="about__list--item">
                        <img src="{{about__item--image}}" alt="" class="about__item--image">
                        <div class="about__item--title">{{about__item--title}}</div>
                    </div>
                {{/about__list--items}}
            </div>

            <a href="#" class="about__button">
                {{about__button}}
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M2.25 10.59L6.88563 6L2.25 1.41L3.67713 0L9.75 6L3.67713 12L2.25 10.59Z" fill="#262626" />
                </svg>
            </a>
        </div>
    </div>
</div>