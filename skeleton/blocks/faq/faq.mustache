<div class="accordion">
    <div class="accordion__main-title">{{title}}</div>

    <div class="accordion-items-container">
        {{#items}}
            <div class="accordion-item{{#opened}} accordion-hidden_opened{{/opened}}">
                <div class="accordion__trigger">
                    <span class="accordion__title">{{title}}</span>
                    <span class="accordion__icon">
                        <svg width="17" height="17" viewBox="0 0 17 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M6.876 16.38V9.504H0V6.858H6.876V0H9.522V6.858H16.38V9.504H9.522V16.38H6.876Z" fill="rgba(47, 47, 48, 0.5)"/>
                        </svg>
                    </span>
                </div>
                <div class="accordion-hidden">
                    {{{content}}}
                </div>
            </div>
        {{/items}}
    </div>
</div>
