                            <div class="dropdown-title">{{drowpon-title}}</div>
                            <div class="dropdown-value">{{drowpon-value}}</div>
                        </div>
                        <button class="dropdown-button">
                            <svg class="dropdown-arrow" width="8" height="5" viewBox="0 0 8 5" fill="none" xmlns="http://www.w3.org/2000/svg">
