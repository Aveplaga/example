<div class="wrapper">
    <div class="hero">
        <div class="hero-wrapper">
            <a href="#" class="hero-link__left">
                <svg class="hero-link__icon" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#2D2926">
                    <path d="m313-440 224 224-57 56-320-320 320-320 57 56-224 224h487v80H313Z" />
                </svg>
            </a>
            <div class="hero-content">
                <div class="hero-slides swiper">
                    <div class="swiper-wrapper">
                        {{#hero-slides}}
