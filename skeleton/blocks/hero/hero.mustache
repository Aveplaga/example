<section class="hero">
    <div class="hero__container container">
        <div class="hero__main">
            <div class="hero__title">{{{hero__title}}}</div>

            <div class="hero__text">
                <div class="hero__subtitle">{{hero__subtitle}}</div>
                <a href="#" class="hero__button">
                    <svg class="hero__icon-arrow" xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 32 32">
                        <path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m6 22l10 8l10-8m-10 8V2" />
                    </svg>
                    {{hero__button}}
                </a>
            </div>
        </div>
    </div>
</section>