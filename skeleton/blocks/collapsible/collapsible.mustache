<div class="collapsible">
    <div class="collapsible__title">{{title}}</div>

    <div class="collapsible-hidden">
        <div class="collapsible__text">{{{text}}}</div>
    </div>

    <button class="collapsible__toggle">
        <span class="collapsible__toggle-text">{{buttonText}}</span>
        <span class="collapsible__arrow">
            <svg width="8" height="5" viewBox="0 0 8 5" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.946667 0L4 3.09042L7.06 0L8 0.951417L4 5L0 0.951417L0.946667 0Z" fill="#1B1B1B" fill-opacity="0.9" />
            </svg>
        </span>
    </button>
</div>