<div class="solutions">
    <div class="solutions-sourcing">
        <div class="sourcing-wrapper">
            <div class="sourcing-content">
                <div class="sourcing-content__title">{{sourcing-content__title}}</div>
                <div class="sourcing-content__subtitle">{{{sourcing-content__subtitle}}}</div>

                <div class="sourcing-content__links">
                    <a href="#" class="sourcing-link__more">{{sourcing-link__more}}</a>
                    <a href="#" class="sourcing-link__application">{{sourcing-link__application}}</a>
                </div>
            </div>
            <img class="sourcing-image" src="{{sourcing-image}}" alt="">
        </div>
    </div>

    <div class="solutions-consulting">
        <div class="consulting-wrapper">
            <div class="consulting-content">
                <div class="consulting-content__title">{{consulting-content__title}}</div>
                <div class="consulting-content__subtitle">{{consulting-content__subtitle}}</div>

                <div class="consulting-content__list">
                    <div class="consulting-list__title">{{consulting-list__title}}</div>
                    <div class="consulting-list__items">
                        {{#consulting-list__items}}
                            <div class="consulting-list__item">
                                <svg class="consulting-item__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <rect x="8" width="11.3136" height="11.3136" transform="rotate(45 8 0)" fill="#FF022C" />
                                    <rect width="5.65692" height="5.65692" transform="matrix(-0.707107 -0.707107 -0.707107 0.707107 12 8)" fill="white" />
                                </svg>
                                <div class="consulting-item__title">{{consulting-item__title}}</div>
                            </div>
                        {{/consulting-list__items}}
                    </div>
                </div>

                <div class="consulting-content__links">
                    <a href="#" class="consulting-link__consultation">{{consulting-link__consultation}}</a>
                    <a href="#" class="consulting-link__more">{{consulting-link__more}}</a>
                </div>
            </div>

            <div class="consulting-content__image">
                <img class="consulting-image" src="{{consulting-image}}" alt="">

                <div class="consulting-content__description">
                    <div class="consulting-description__item">
