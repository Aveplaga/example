<div class="info">
    <div class="info-wrapper">
        <img class="right-logo_element" src="{{right-logo_element}}" alt="">
        <img class="left-logo_element" src="{{left-logo_element}}" alt="">
        <div class="info-right_item">
            <div class="right-wrapper_content">
                <div class="info-right_content">
                    <div class="info-right_title">{{info-right_title}}</div>
                    <div class="info-right_subtitle">{{{info-right_subtitle}}}</div>

                    <div class="info-right_buttons">
                        <a href="#" class="right-button_more">{{right-button_more}}</a>
                        <a href="#" class="right-button_application">{{right-button_application}}</a>
                    </div>
                </div>
            </div>
            <img class="right-image" src="{{right-image}}" alt="">
        </div>
        <div class="info-left_item">
            <div class="left-wrapper_content">
                <div class="info-left_content">
                    <div class="info-left_title">{{info-left_title}}</div>
                    <div class="info-left_subtitle">{{info-left_subtitle}}</div>

                    <div class="info-left_list">
                        <div class="left-list_title">{{left-list_title}}</div>
                        <div class="left-list_items">
                            {{#left-list_items}}
                                <div class="left-list_item">
                                    <svg class="rrr" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <rect x="8" width="11.3136" height="11.3136" transform="rotate(45 8 0)" fill="#FF022C" />
                                        <rect width="5.65692" height="5.65692" transform="matrix(-0.707107 -0.707107 -0.707107 0.707107 12 8)" fill="white" />
                                    </svg>
                                    <div class="list-item_title">{{list-item_title}}</div>
                                </div>
                            {{/left-list_items}}
                        </div>
                    </div>

                    <div class="info-left_buttons">
                        <a href="#" class="left-button_consultation">{{left-button_consultation}}</a>
                        <a href="#" class="left-button_more">{{left-button_more}}</a>
                    </div>
                </div>
            </div>
