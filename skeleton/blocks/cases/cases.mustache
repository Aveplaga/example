<div class="cases">
    <div class="layout">
        <div class="cases-cap">
            <div class="cases-cap__title">{{cases-cap__title}}</div>
            <div class="cases-cap__links">
                <a href="#" class="cases-button__left">
                    <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#292929">
                        <path d="M384-288 192-480l192-192 51 51-105 105h438v72H330l105 105-51 51Z" />
                    </svg>
                </a>
                <a href="#" class="cases-button__right">
                    <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#292929">
                        <path d="m576-288-51-51 105-105H192v-72h438L525-621l51-51 192 192-192 192Z" />
                    </svg>
                </a>
            </div>
        </div>

        <div class="cases-list swiper">
            <div class="swiper-wrapper">
                {{#cases-items}}
                    <div class="cases-item swiper-slide">
                        <div class="cases-item__wrapper">
                            <img src="{{cases-item__image}}" alt="" class="cases-item__image">

                            <div class="cases-item__content">
                                <div class="cases-item__title-wrap"><span class="cases-item__title">{{cases-item__title}}</span></div>
                                <div class="cases-item__subtext">{{cases-item__subtext}}</div>
                                <div class="cases-item__subtitle">{{cases-item__subtitle}}</div>
                                <a href="#" class="cases-item__content-link">
                                    <span class="cases-item__link-text tablet-text">{{cases-item__link-tablet}}</span>
                                    <span class="cases-item__link-text mobile-text">{{cases-item__link-mobile}}</span>
                                </a>
                            </div>
                        </div>

                        <div class="cases-item__list">
                            {{#cases-items__features}}
                                <div class="cases-item__features">
                                    <img class="cases-features__icon" src="{{cases-features__icon}}" alt="">
                                    <div class="cases-features__title">{{cases-features__title}}</div>
                                </div>
                            {{/cases-items__features}}
                        </div>
                        <a href="#" class="cases-item__link">{{cases-item__link}}</a>
                    </div>
                {{/cases-items}}
            </div>
        </div>
        <div class="cases-pagination">
            <a href="#" class="cases-button__left hidden-button">
                <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#292929">
                    <path d="M384-288 192-480l192-192 51 51-105 105h438v72H330l105 105-51 51Z" />
                </svg>
            </a>
            <div class="cases-pagination__list">
                <div class="swiper-pagination">
                    {{#cases-pagination__dots}}
                        <div class="cases-pagination__dot"></div>
                    {{/cases-pagination__dots}}
                </div>
            </div>
            <a href="#" class="cases-button__right hidden-button">
                <svg xmlns="http://www.w3.org/2000/svg" height="20px" viewBox="0 -960 960 960" width="20px" fill="#292929">
                    <path d="m576-288-51-51 105-105H192v-72h438L525-621l51-51 192 192-192 192Z" />
                </svg>
            </a>
        </div>
        <a href="#" class="cases-link">{{cases-link}}</a>
    </div>
</div>