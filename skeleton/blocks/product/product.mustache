<div class="inner">
    <nav class="navigation">
        {{#links}}
            <a href="{{url}}" class="navigation__link">
                {{link}}
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"
                    xmlns="http://www.w3.org/2000/svg">
                    <path d="M6.53073 2.46937L11.5307 7.46937C11.6007 7.53905 11.6561 7.62184 11.694 7.71301C11.7318 7.80417 11.7513 7.90191 11.7513 8.00062C11.7513 8.09933 11.7318 8.19707 11.694 8.28824C11.6561 8.3794 11.6007 8.46219 11.5307 8.53187L6.53073 13.5319C6.38984 13.6728 6.19874 13.7519 5.99948 13.7519C5.80023 13.7519 5.60913 13.6728 5.46823 13.5319C5.32734 13.391 5.24818 13.1999 5.24818 13.0006C5.24818 12.8014 5.32734 12.6103 5.46823 12.4694L9.93761 8L5.46761 3.53062C5.32671 3.38973 5.24756 3.19863 5.24756 2.99937C5.24756 2.80011 5.32671 2.60902 5.46761 2.46812C5.60851 2.32723 5.7996 2.24807 5.99886 2.24807C6.19812 2.24807 6.38921 2.32723 6.53011 2.46812L6.53073 2.46937Z"
                        fill="black" fill-opacity="0.6" />
                </svg>
            </a>
        {{/links}}
    </nav>

    <section class="content">

        <div class="content__gallery-wrapper">

            <div class="content__gallery swiper mySwiper">
                <div class="swiper-wrapper">
                    {{#images}}
                        <div class="swiper-slide">
                            <a href="#" class="content__gallery-link">
                                <img class="content__image-small" loading="lazy" src="{{image}}" alt="">
                            </a>
                        </div>
                    {{/images}}
                </div>
            </div>

            <div thumbsSlider="" class="swiper mySwiper2">
                <div class="swiper-wrapper">
                    {{#images}}
                        <div class="swiper-slide">
                            <img class="content__image-main" loading="lazy" src="{{image}}" alt="">
                        </div>
                    {{/images}}
                </div>
            </div>


        </div>

        <div class="content__info">
            <div class="content__title">{{title}}</div>

            <div class="content__rating">
                <div class="content__stars">
                    {{#stars}}
                        <a href="#" class="content__star">
                            <svg width="25" height="23" viewBox="0 0 25 23" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path d="M12.3562 0L15.8569 7.53796L24.1077 8.53794L18.0204 14.1966L19.619 22.3526L12.3562 18.3119L5.09341 22.3526L6.69201 14.1966L0.604756 8.53794L8.85555 7.53796L12.3562 0Z"
                                    fill="#FFC633" />
                            </svg>
                        </a>
                    {{/stars}}
                </div>

                <div class="content__estimation">{{{rating}}}</div>

            </div>

            <div class="content__price">
                <div class="content__price-current">{{{price}}}</div>
                <div class="content__price-old">{{discount}}</div>
            </div>

            <div class="content__description">{{subText}}</div>

            <div class="content__color">
                <div class="content__color-title">{{colorTitle}}</div>
                <div class="content__color-list">
                    {{#colors}}
                        <div class="content__color-item {{#selector}}content__color-item--active{{/selector}}"
                            style="background-color: {{color}};">
                            <svg class="content__color-check" width="16" height="16" viewBox="0 0 16 16" fill="none"
                                xmlns="http://www.w3.org/2000/svg">
                                <path d="M6 10L3 7L4 6L6 8L12 2L13 3L6 10Z" fill="white" />
                            </svg>
                        </div>
                    {{/colors}}
                </div>

            </div>

            <div class="content__size">
                <div class="content__size-title">{{sizeTitle}}</div>
                <div class="content__size-buttons">
                    {{#buttons}}
                        <a href="#" class="content__size-button {{#isActive}}active{{/isActive}}">{{button}}</a>
                    {{/buttons}}
                </div>
            </div>

            <div class="content__purchase">
                <div class="content__purchase-buttons">

                    <div class="content__counter">
                        <button class="content__counter-button minus">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M21.375 12C21.375 12.2984 21.2565 12.5845 21.0455 12.7955C20.8345 13.0065 20.5484 13.125 20.25 13.125H3.75C3.45163 13.125 3.16548 13.0065 2.9545 12.7955C2.74353 12.5845 2.625 12.2984 2.625 12C2.625 11.7016 2.74353 11.4155 2.9545 11.2045C3.16548 10.9935 3.45163 10.875 3.75 10.875H20.25C20.5484 10.875 20.8345 10.9935 21.0455 11.2045C21.2565 11.4155 21.375 11.7016 21.375 12Z" fill="black" />
                            </svg>
                        </button>

                        <span class="counter-value">{{counterButton}}</span>

                        <button class="content__counter-button plus">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M21.375 12C21.375 12.2984 21.2565 12.5845 21.0455 12.7955C20.8345 13.0065 20.5484 13.125 20.25 13.125H13.125V20.25C13.125 20.5484 13.0065 20.8345 12.7955 21.0455C12.5845 21.2565 12.2984 21.375 12 21.375C11.7016 21.375 11.4155 21.2565 11.2045 21.0455C10.9935 20.8345 10.875 20.5484 10.875 20.25V13.125H3.75C3.45163 13.125 3.16548 13.0065 2.9545 12.7955C2.74353 12.5845 2.625 12.2984 2.625 12C2.625 11.7016 2.74353 11.4155 2.9545 11.2045C3.16548 10.9935 3.45163 10.875 3.75 10.875H10.875V3.75C10.875 3.45163 10.9935 3.16548 11.2045 2.9545C11.4155 2.74353 11.7016 2.625 12 2.625C12.2984 2.625 12.5845 2.74353 12.7955 2.9545C13.0065 3.16548 13.125 3.45163 13.125 3.75V10.875H20.25C20.5484 10.875 20.8345 10.9935 21.0455 11.2045C21.2565 11.4155 21.375 11.7016 21.375 12Z" fill="black" />
                            </svg>
                        </button>
                    </div>

                    <button class="content__purchase-button">{{purchaseButton}}</button>
                </div>
            </div>
        </div>
    </section>
</div>